<Window x:Class="LnisAfsValidator.App.AfsDashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LNIS AFS RAW Validator" Width="1320" Height="820" MinWidth="1050" MinHeight="680" Background="#F3F5F8">
  <Window.Resources>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="4"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="14,7"/></Style>
  </Window.Resources>
  <!-- 역할·네트워크, 입력·판정 기준, 측정 결과와 실행 상태를 위에서 아래 순서로 배치한다. -->
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <GroupBox Header="실행 역할"><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"/></GroupBox>
      <GroupBox Grid.Column="1" Header="UDP 네트워크"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Broadcast 주소" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding BroadcastAddress}"/>
        <TextBlock Grid.Row="1" Text="데이터 포트" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DataPort}"/>
        <TextBlock Grid.Row="2" Text="결과 포트" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ResultPort}"/>
      </Grid></GroupBox>
      <GroupBox Grid.Column="2" Header="고정 AFS 설정"><StackPanel><TextBlock Text="PRN 8 · Custom Type 63" FontWeight="SemiBold"/><TextBlock Text="6000심볼 → 750바이트 UDP"/><TextBlock Text="각 패킷 3회 중복 송신"/></StackPanel></GroupBox>
    </Grid>
    <GroupBox Grid.Row="1" Header="입력 및 판정 기준"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="capture.graw" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding CapturePath}"/><Button Grid.Column="2" Content="찾아보기" Command="{Binding BrowseCaptureCommand}"/>
      <TextBlock Grid.Row="1" Text="PRN 8 Almanac" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AlmanacPath}"/><Button Grid.Row="1" Grid.Column="2" Content="찾아보기" Command="{Binding BrowseAlmanacCommand}"/>
      <UniformGrid Grid.Row="2" Grid.ColumnSpan="3" Columns="6" Margin="0,8,0,0">
        <StackPanel><CheckBox Content="최소 링크 가용률 (%)" IsChecked="{Binding ApplyAvailability}"/><TextBox Text="{Binding MinimumAvailability}"/></StackPanel>
        <StackPanel><CheckBox Content="최대 평균 지연 (ms)" IsChecked="{Binding ApplyAverageLatency}"/><TextBox Text="{Binding MaximumAverageLatency}"/></StackPanel>
        <StackPanel><CheckBox Content="최대 지연 (ms)" IsChecked="{Binding ApplyMaximumLatency}"/><TextBox Text="{Binding MaximumLatency}"/></StackPanel>
        <StackPanel><CheckBox Content="최소 처리량 (byte/s)" IsChecked="{Binding ApplyThroughput}"/><TextBox Text="{Binding MinimumThroughput}"/></StackPanel>
        <StackPanel><CheckBox Content="최대 손실률 (%)" IsChecked="{Binding ApplyLoss}"/><TextBox Text="{Binding MaximumLoss}"/></StackPanel>
        <StackPanel><CheckBox Content="최소 전달률 (%)" IsChecked="{Binding ApplyDelivery}"/><TextBox Text="{Binding MinimumDelivery}"/></StackPanel>
      </UniformGrid>
    </Grid></GroupBox>
    <GroupBox Grid.Row="2" Header="AFS 오류·손실 실험">
      <DockPanel><Button DockPanel.Dock="Right" Content="오류 실험 창 열기" Command="{Binding OpenErrorExperimentCommand}" Background="#175CD3" Foreground="White" FontWeight="SemiBold"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Test B/C 오류정정, Test D 재동기, Test E UDP Drop은 별도 창에서 조건별로 실행하고 실제 시험 파일을 저장합니다."/></DockPanel>
    </GroupBox>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <GroupBox Header="성능지표"><DataGrid ItemsSource="{Binding Metrics}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns>
        <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="지표" Binding="{Binding Name}" Width="240"/><DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="값" Binding="{Binding Value}" Width="110"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="80"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="110"/>
      </DataGrid.Columns></DataGrid></GroupBox>
      <GroupBox Grid.Column="1" Header="실행 로그"><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></GroupBox>
    </Grid>
    <Grid Grid.Row="4" Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="상태: " FontWeight="Bold"/><TextBlock Text="{Binding State}"/><TextBlock Text="   최종 판정: " FontWeight="Bold"/><TextBlock Text="{Binding Verdict}" FontSize="17" FontWeight="Bold"/><TextBlock Text="   "/><TextBlock Text="{Binding Error}" Foreground="#B42318"/></StackPanel><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="16" Margin="0,5,10,0"/><TextBlock Text="{Binding RunDirectory}" Foreground="#667085"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="시험 시작" Command="{Binding StartCommand}"/><Button Content="취소" Command="{Binding CancelCommand}"/><Button Content="결과 폴더" Command="{Binding OpenResultsCommand}"/></StackPanel>
    </Grid>
  </Grid>
</Window>
