<Window x:Class="LnisAfsValidator.App.AfsErrorExperimentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LNIS AFS 오류·손실 실험" Width="1400" Height="900" MinWidth="1100" MinHeight="720" Background="#F3F5F8">
  <Window.Resources>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="15,8"/></Style>
  </Window.Resources>
  <!-- 상단은 시험 조건, 중앙은 로그와 지표, 하단은 진행 상태와 명령 영역이다. -->
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl>
      <TabItem Header="Test B/C/D · AFS 오류정정·재동기">
        <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <GroupBox Header="시험 조건">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/><ColumnDefinition Width="280"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="오류 유형" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding ErrorModes}" SelectedItem="{Binding ErrorMode}"/>
              <TextBlock Grid.Column="2" Text="오류 개수" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding ErrorCountsText}" ToolTip="Random/Burst 예: 1,2,5,10,20,50 · SyncLoss: 1~68"/>
              <TextBlock Grid.Column="4" Text="조건별 반복" VerticalAlignment="Center"/><TextBox Grid.Column="5" Text="{Binding TrialsPerCondition}"/>
              <TextBlock Grid.Column="6" Text="Seed" VerticalAlignment="Center"/><TextBox Grid.Column="7" Text="{Binding ExperimentSeed}"/>
              <Button Grid.Column="8" Content="오류 시험 실행" Command="{Binding RunFecCommand}" Background="#175CD3" Foreground="White" FontWeight="SemiBold"/>
            </Grid>
          </GroupBox>
          <Border Grid.Row="1" Margin="10,2" Padding="10" Background="#EFF8FF" BorderBrush="#B2DDFF" BorderThickness="1" CornerRadius="4">
            <TextBlock TextWrapping="Wrap" Text="Random은 인터리빙 완료 영역의 임의 심볼을 반전하고, Burst는 연속 심볼을 반전합니다. SyncLoss는 ‘정상 → SP 훼손 → 정상’ 3프레임 스트림을 만들어 다음 SP 재탐색과 Decode 복귀시간을 측정합니다. 기본 100회 반복을 권장합니다."/>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Test E · UDP Packet Drop">
        <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <GroupBox Header="입력 파일"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="capture.graw" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding CapturePath}"/><Button Grid.Column="2" Content="찾아보기" Command="{Binding BrowseCaptureCommand}"/>
            <TextBlock Grid.Row="1" Text="PRN 8 Almanac" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AlmanacPath}"/><Button Grid.Row="1" Grid.Column="2" Content="찾아보기" Command="{Binding BrowseAlmanacCommand}"/>
          </Grid></GroupBox>
          <GroupBox Grid.Row="1" Header="UDP 손실 조건"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="180"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="실행 역할" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding UdpRole}"/>
            <TextBlock Grid.Column="2" Text="Broadcast" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding BroadcastAddress}"/>
            <TextBlock Grid.Column="4" Text="데이터 포트" VerticalAlignment="Center"/><TextBox Grid.Column="5" Text="{Binding DataPort}"/>
            <TextBlock Grid.Column="6" Text="결과 포트" VerticalAlignment="Center"/><TextBox Grid.Column="7" Text="{Binding ResultPort}"/>
            <TextBlock Grid.Column="8" Text="중복 횟수" VerticalAlignment="Center"/><TextBox Grid.Column="9" Text="{Binding RepeatCount}"/>
          </Grid></GroupBox>
          <GroupBox Grid.Row="2" Header="의도적 Drop"><StackPanel>
            <WrapPanel><TextBlock Text="Drop Rate (%)" VerticalAlignment="Center" Margin="4"/><TextBox Width="100" Text="{Binding UdpDropRatePercent}"/><TextBlock Text="Seed" VerticalAlignment="Center" Margin="14,4,4,4"/><TextBox Width="100" Text="{Binding UdpDropSeed}"/><Button Content="UDP 손실 시험 실행" Command="{Binding RunUdpDropCommand}" Background="#B54708" Foreground="White" FontWeight="SemiBold"/></WrapPanel>
            <TextBlock Margin="4" Foreground="#475467" TextWrapping="Wrap" Text="Frame 데이터그램만 설정 비율로 제거합니다. SessionStart/End와 결과 패킷은 항상 전송하여 시험 제어 손실과 AFS 데이터 손실을 분리합니다. 같은 Seed는 같은 프레임·복제본을 제거합니다."/>
          </StackPanel></GroupBox>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <GroupBox Header="시험 결과"><DataGrid ItemsSource="{Binding Metrics}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns>
        <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="지표" Binding="{Binding Name}" Width="280"/><DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="값" Binding="{Binding Value}" Width="110"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="70"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="100"/>
      </DataGrid.Columns></DataGrid></GroupBox>
      <GroupBox Grid.Column="1" Header="실행 로그"><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></GroupBox>
    </Grid>
    <Grid Grid.Row="2" Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="상태: " FontWeight="Bold"/><TextBlock Text="{Binding State}"/><TextBlock Text="   판정: " FontWeight="Bold"/><TextBlock Text="{Binding Verdict}" FontSize="17" FontWeight="Bold"/><TextBlock Text="   "/><TextBlock Text="{Binding Error}" Foreground="#B42318"/></StackPanel><ProgressBar Value="{Binding Progress}" Maximum="100" Height="16" Margin="0,5,10,0"/><TextBlock Text="{Binding ResultDirectory}" Foreground="#667085"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="취소" Command="{Binding CancelCommand}"/><Button Content="결과 폴더" Command="{Binding OpenResultsCommand}"/></StackPanel>
    </Grid>
  </Grid>
</Window>
