<Window x:Class="LnisAfsValidator.App.GnssCaptureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ZED-F9P GNSS RAW 수집" Width="1100" Height="650" MinWidth="900" MinHeight="550" Background="#F3F5F8">
  <Window.Resources>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="8"/><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="15,8"/></Style>
  </Window.Resources>
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <GroupBox Header="입력 설정"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="250"/><ColumnDefinition Width="120"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="입력 방식" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/>
      <TextBlock Grid.Column="2" Text="세션 이름" VerticalAlignment="Center"/><TextBox Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding SessionName}"/>
      <TextBlock Grid.Row="1" Text="COM 포트" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding PortName}"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="Baud rate" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding BaudRate}"/><Button Grid.Row="1" Grid.Column="4" Content="포트 새로고침" Command="{Binding RefreshPortsCommand}" HorizontalAlignment="Left"/>
      <TextBlock Grid.Row="2" Text="Replay .ubx 파일" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding ReplayPath}"/>
    </Grid></GroupBox>
    <GroupBox Grid.Row="1" Header="수집 통계"><UniformGrid Columns="8"><StackPanel><TextBlock Text="Bytes"/><TextBlock Text="{Binding Statistics.BytesRead}" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="Valid"/><TextBlock Text="{Binding Statistics.ValidFrames}" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="RAWX"/><TextBlock Text="{Binding Statistics.RawxFrames}" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="SFRBX"/><TextBlock Text="{Binding Statistics.SfrbxFrames}" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="Checksum errors"/><TextBlock Text="{Binding Statistics.ChecksumErrors}" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="Unsupported"/><TextBlock Text="{Binding Statistics.UnsupportedFrames}" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="Other GNSS"/><TextBlock Text="{Binding Statistics.UnsupportedConstellations}" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="Envelopes"/><TextBlock Text="{Binding Statistics.EnvelopesWritten}" FontWeight="Bold"/></StackPanel></UniformGrid></GroupBox>
    <TextBlock Grid.Row="2" Margin="12" Text="읽기 전용: 앱은 ZED-F9P 설정을 변경하지 않습니다. RAWX/SFRBX 출력은 u-center 등에서 미리 설정해야 합니다." Foreground="#475467"/>
    <GroupBox Grid.Row="3" Header="상태"><StackPanel><TextBlock Text="{Binding State}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Error}" Foreground="#B42318" Margin="0,10" TextWrapping="Wrap"/><TextBlock Text="{Binding RunDirectory}" TextWrapping="Wrap"/><TextBlock Text="저장 루트" FontWeight="Bold" Margin="0,15,0,0"/><TextBlock Text="{Binding ResultRoot}" Foreground="#667085" TextWrapping="Wrap"/></StackPanel></GroupBox>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="수집/Replay 시작" Command="{Binding StartCommand}"/><Button Content="중지" Command="{Binding StopCommand}"/><Button Content="결과 열기" Command="{Binding OpenResultsCommand}"/></StackPanel>
  </Grid>
</Window>
