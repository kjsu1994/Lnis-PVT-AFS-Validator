<Window x:Class="LnisAfsValidator.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LNIS AFS End-to-End Validator" Width="1440" Height="900" MinWidth="1100" MinHeight="700" Background="#F3F5F8">
  <Window.Resources>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="4"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="14,7"/></Style>
  </Window.Resources>
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <GroupBox Header="시험 및 네트워크" Grid.Column="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="역할" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"/>
        <TextBlock Grid.Row="1" Text="원격 PC 주소" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RemoteAddress}"/>
        <TextBlock Grid.Row="2" Text="TCP 포트" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port}"/>
      </Grid></GroupBox>
      <GroupBox Header="LANS-AFS-SIM" Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="실행 방식" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding GeneratorMode}"/>
        <TextBlock Grid.Row="1" Text="실행 파일" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GeneratorPath}"/>
        <TextBlock Grid.Row="2" Text="작업 폴더" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GeneratorWorking}"/>
      </Grid></GroupBox>
      <GroupBox Header="PocketSDR-AFS" Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="실행 방식" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding ReceiverMode}"/>
        <TextBlock Grid.Row="1" Text="실행 파일" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReceiverPath}"/>
        <TextBlock Grid.Row="2" Text="작업 폴더" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReceiverWorking}"/>
      </Grid></GroupBox>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <GroupBox Header="시험 시나리오"><UniformGrid Columns="6">
        <StackPanel><TextBlock Text="시나리오 이름"/><TextBox Text="{Binding ScenarioName}"/></StackPanel><StackPanel><TextBlock Text="위도 (deg)"/><TextBox Text="{Binding Latitude}"/></StackPanel><StackPanel><TextBlock Text="경도 (deg)"/><TextBox Text="{Binding Longitude}"/></StackPanel><StackPanel><TextBlock Text="고도 (m)"/><TextBox Text="{Binding Height}"/></StackPanel><StackPanel><TextBlock Text="위치 허용오차 (m) *"/><TextBox Text="{Binding PositionTolerance}"/></StackPanel><StackPanel><TextBlock Text="시간 허용오차 (s) *"/><TextBox Text="{Binding TimeTolerance}"/></StackPanel>
        <StackPanel><TextBlock Text="시험 시간 (s)"/><TextBox Text="{Binding Duration}"/></StackPanel><StackPanel><TextBlock Text="샘플률 (MHz)"/><TextBox Text="{Binding SampleRate}"/></StackPanel><StackPanel><TextBlock Text="PRN"/><TextBox Text="{Binding Prns}"/></StackPanel><StackPanel><TextBlock Text="최소 위성 수"/><TextBox Text="{Binding MinimumSatellites}"/></StackPanel><StackPanel Grid.ColumnSpan="2"><TextBlock Text="Almanac 파일"/><TextBox Text="{Binding AlmanacPath}"/></StackPanel>
      </UniformGrid></GroupBox>
      <GroupBox Header="WSL 실행 환경" Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="배포판"/><TextBox Grid.Column="1" Text="{Binding WslDistribution}"/><TextBlock Grid.Row="1" Text="실행 루트"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WslRunRoot}"/></Grid></GroupBox>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <GroupBox Header="프로세스 로그"><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></GroupBox>
      <GroupBox Header="검증 결과" Grid.Column="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="최종 판정: " FontWeight="Bold"/><TextBlock Text="{Binding Verdict}" FontWeight="Bold" FontSize="18"/><TextBlock Text="  "/><TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Checks}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="항목" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="판정" Binding="{Binding Verdict}" Width="90"/><DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid></Grid></GroupBox>
    </Grid>
    <Grid Grid.Row="3" Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding State}" FontWeight="SemiBold"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="16" Margin="0,5,10,0"/><TextBlock Text="{Binding RunDirectory}" Foreground="#667085"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="GNSS RAW 수집" Click="OpenGnssCapture_Click"/><Button Content="시험 시작" Command="{Binding StartCommand}"/><Button Content="취소" Command="{Binding CancelCommand}"/><Button Content="결과 폴더 열기" Command="{Binding OpenResultsCommand}"/></StackPanel></Grid>
  </Grid>
</Window>
