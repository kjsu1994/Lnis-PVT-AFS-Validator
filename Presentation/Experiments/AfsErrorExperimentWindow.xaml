<Window x:Class="LnisAfsValidator.App.AfsErrorExperimentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFS CRC·LDPC·인터리빙 검증" Width="1480" Height="900" MinWidth="1180" MinHeight="720" Background="#F3F5F8">
  <Window.Resources>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="15,8"/></Style>
  </Window.Resources>
  <!-- CRC·LDPC·인터리빙 처리 단계와 조건별 복구율을 한 화면에서 비교한다. -->
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <GroupBox Header="AFS 오픈소스 코덱 처리 사슬">
      <UniformGrid Columns="7">
        <Border Padding="10" Margin="3" Background="#EFF8FF"><StackPanel><TextBlock Text="CRC-24Q" FontWeight="Bold"/><TextBlock Text="SB2 1176→1200"/><TextBlock Text="SB3/4 846→870"/></StackPanel></Border>
        <Border Padding="10" Margin="3" Background="#ECFDF3"><StackPanel><TextBlock Text="LDPC 부호화·천공" FontWeight="Bold"/><TextBlock Text="SB2 → 2400"/><TextBlock Text="SB3/4 → 1740"/></StackPanel></Border>
        <Border Padding="10" Margin="3" Background="#FFF6ED"><StackPanel><TextBlock Text="인터리빙" FontWeight="Bold"/><TextBlock Text="5880심볼"/><TextBlock Text="60 × 98"/></StackPanel></Border>
        <Border Padding="10" Margin="3" Background="#FEF3F2"><StackPanel><TextBlock Text="오류 주입" FontWeight="Bold"/><TextBlock Text="Random / Burst"/><TextBlock Text="index 120~5999"/></StackPanel></Border>
        <Border Padding="10" Margin="3" Background="#FFF6ED"><StackPanel><TextBlock Text="디인터리빙" FontWeight="Bold"/><TextBlock Text="5880심볼"/><TextBlock Text="원래 블록 분리"/></StackPanel></Border>
        <Border Padding="10" Margin="3" Background="#ECFDF3"><StackPanel><TextBlock Text="LDPC 복호" FontWeight="Bold"/><TextBlock Text="SB2·SB3·SB4"/><TextBlock Text="블록별 성공률"/></StackPanel></Border>
        <Border Padding="10" Margin="3" Background="#EFF8FF"><StackPanel><TextBlock Text="CRC·원본 비교" FontWeight="Bold"/><TextBlock Text="CRC 통과율"/><TextBlock Text="프레임 복원률"/></StackPanel></Border>
      </UniformGrid>
    </GroupBox>
    <GroupBox Grid.Row="1" Header="시험 조건">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition Width="300"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="70"/><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="오류 유형" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding ErrorModes}" SelectedItem="{Binding ErrorMode}"/>
        <TextBlock Grid.Column="2" Text="오류 심볼 수" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding ErrorCountsText}" ToolTip="Random/Burst: 최대 5880 · SyncLoss: 최대 68"/>
        <TextBlock Grid.Column="4" Text="조건별 반복" VerticalAlignment="Center"/><TextBox Grid.Column="5" Text="{Binding TrialsPerCondition}"/>
        <TextBlock Grid.Column="6" Text="Seed" VerticalAlignment="Center"/><TextBox Grid.Column="7" Text="{Binding ExperimentSeed}"/>
        <Button Grid.Column="8" Content="시험 실행" Command="{Binding RunCommand}" Background="#175CD3" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right"/>
      </Grid>
    </GroupBox>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TabControl Margin="6">
        <TabItem Header="Test B/C · 오류 개수별 정정률">
          <DataGrid ItemsSource="{Binding FecSummaries}" AutoGenerateColumns="False" IsReadOnly="True" FrozenColumnCount="3">
            <DataGrid.Columns>
              <DataGridTextColumn Header="방식" Binding="{Binding Mode}" Width="80"/><DataGridTextColumn Header="오류 심볼" Binding="{Binding ErrorCount}" Width="80"/><DataGridTextColumn Header="반복" Binding="{Binding Trials}" Width="65"/>
              <DataGridTextColumn Header="전체 LDPC %" Binding="{Binding LdpcSuccessRate, StringFormat=F2}" Width="95"/><DataGridTextColumn Header="전체 CRC %" Binding="{Binding CrcSuccessRate, StringFormat=F2}" Width="95"/><DataGridTextColumn Header="프레임 복원 %" Binding="{Binding FrameRestoreRate, StringFormat=F2}" Width="105"/>
              <DataGridTextColumn Header="SB2 LDPC %" Binding="{Binding Sb2LdpcSuccessRate, StringFormat=F2}" Width="95"/><DataGridTextColumn Header="SB3 LDPC %" Binding="{Binding Sb3LdpcSuccessRate, StringFormat=F2}" Width="95"/><DataGridTextColumn Header="SB4 LDPC %" Binding="{Binding Sb4LdpcSuccessRate, StringFormat=F2}" Width="95"/>
              <DataGridTextColumn Header="SB2 CRC %" Binding="{Binding Sb2CrcSuccessRate, StringFormat=F2}" Width="90"/><DataGridTextColumn Header="SB3 CRC %" Binding="{Binding Sb3CrcSuccessRate, StringFormat=F2}" Width="90"/><DataGridTextColumn Header="SB4 CRC %" Binding="{Binding Sb4CrcSuccessRate, StringFormat=F2}" Width="90"/><DataGridTextColumn Header="평균 수정 비트" Binding="{Binding AverageChangedBits, StringFormat=F2}" Width="110"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Test D · 재동기">
          <DataGrid ItemsSource="{Binding SyncSummaries}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns>
            <DataGridTextColumn Header="SP 오류 심볼" Binding="{Binding SyncErrorCount}" Width="120"/><DataGridTextColumn Header="반복" Binding="{Binding Trials}" Width="80"/><DataGridTextColumn Header="손상 프레임 거부 %" Binding="{Binding DamagedFrameRejectionRate, StringFormat=F2}" Width="150"/><DataGridTextColumn Header="Sync 복구 %" Binding="{Binding SyncRecoveryRate, StringFormat=F2}" Width="130"/><DataGridTextColumn Header="Decode 복구 %" Binding="{Binding DecodeRecoveryRate, StringFormat=F2}" Width="140"/><DataGridTextColumn Header="평균 복구시간(s)" Binding="{Binding AverageRecoverySeconds, StringFormat=F3}" Width="150"/>
          </DataGrid.Columns></DataGrid>
        </TabItem>
      </TabControl>
      <GroupBox Grid.Column="1" Header="실행 로그"><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></GroupBox>
    </Grid>
    <Grid Grid.Row="3" Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="상태: " FontWeight="Bold"/><TextBlock Text="{Binding State}"/><TextBlock Text="   판정: " FontWeight="Bold"/><TextBlock Text="{Binding Verdict}" FontSize="17" FontWeight="Bold"/><TextBlock Text="   "/><TextBlock Text="{Binding Error}" Foreground="#B42318"/></StackPanel><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="16" Margin="0,5,10,0"/><TextBlock Text="{Binding ResultDirectory}" Foreground="#667085"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="취소" Command="{Binding CancelCommand}"/><Button Content="결과 폴더" Command="{Binding OpenResultsCommand}"/></StackPanel>
    </Grid>
  </Grid>
</Window>
