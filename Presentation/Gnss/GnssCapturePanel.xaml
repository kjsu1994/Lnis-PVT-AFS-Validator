<UserControl x:Class="LnisAfsValidator.App.GnssCapturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="4"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="4"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="11,6"/></Style>
  </UserControl.Resources>
  <!-- 송신부 안에서 사용되는 제조사 중립 COM 입력 패널이다. -->
  <Grid Margin="4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
    <GroupBox Header="사용 가능한 COM 포트" Margin="4" Padding="8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="포트" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Text="{Binding SelectedPort}" IsEditable="True"/><Button Grid.Column="2" Content="새로고침" Command="{Binding RefreshPortsCommand}"/>
        <TextBlock Grid.Row="1" Text="Baud rate" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}" IsEditable="True"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"><CheckBox Content="DTR" IsChecked="{Binding DtrEnable}" Margin="4"/><CheckBox Content="RTS" IsChecked="{Binding RtsEnable}" Margin="14,4,4,4"/></StackPanel>
      </Grid>
    </GroupBox>
    <GroupBox Grid.Column="1" Header="프로토콜·저장" Margin="4" Padding="8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="어댑터" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" DisplayMemberPath="DisplayName"/>
        <TextBlock Grid.Row="1" Text="저장 폴더" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputRoot}"/><Button Grid.Row="1" Grid.Column="2" Content="찾기" Command="{Binding BrowseOutputCommand}"/>
        <TextBlock Grid.Row="2" Text="장비 모델" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ReceiverModel}"/>
        <TextBlock Grid.Row="3" Text="세션 이름" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SessionName}"/>
      </Grid>
    </GroupBox>
    <GroupBox Grid.Column="2" Header="GNSS RAW 수집" Margin="4" Padding="8">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding ProtocolDescription}" TextWrapping="Wrap" Foreground="#475467"/>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,5"><StackPanel><TextBlock Text="수신 bytes" Foreground="#667085"/><TextBlock Text="{Binding Statistics.BytesRead, StringFormat={}{0:N0}}" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="관측 Epoch" Foreground="#667085"/><TextBlock Text="{Binding Statistics.ObservationEpochs, StringFormat={}{0:N0}}" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="항법 Update" Foreground="#667085"/><TextBlock Text="{Binding Statistics.NavigationUpdates, StringFormat={}{0:N0}}" FontWeight="Bold"/></StackPanel></UniformGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock Text="상태: " FontWeight="Bold"/><TextBlock Text="{Binding State}"/><TextBlock Text="  "/><TextBlock Text="{Binding Error}" Foreground="#B42318"/></StackPanel>
        <StackPanel Grid.Row="3"><TextBlock Text="{Binding RawPath, StringFormat=원본: {0}}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CanonicalPath, StringFormat=송신 RAW: {0}}" TextTrimming="CharacterEllipsis" Foreground="#175CD3"/></StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="수집 시작" Command="{Binding StartCommand}"/><Button Content="수집 중지" Command="{Binding StopCommand}"/><Button Content="결과 폴더" Command="{Binding OpenResultsCommand}"/></StackPanel>
      </Grid>
    </GroupBox>
  </Grid>
</UserControl>
