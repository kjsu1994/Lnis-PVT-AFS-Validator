<Window x:Class="LnisAfsValidator.App.AfsReceiverWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LNIS AFS 수신부" Width="1240" Height="780" MinWidth="980" MinHeight="650" Background="#F3F5F8">
  <Window.Resources><Style TargetType="GroupBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="White"/></Style><Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style><Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="14,7"/></Style></Window.Resources>
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- 수신 포트 설정과 프레임 복호 처리 순서를 역할 전용 영역에 표시한다. -->
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <GroupBox Header="UDP 수신"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="데이터 포트" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding DataPort}"/><TextBlock Grid.Row="1" Text="결과 포트" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ResultPort}"/><TextBlock Grid.Row="2" Text="송신 중복 횟수" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RepeatCount}"/><TextBlock Grid.Row="3" Text="결과 저장 폴더" VerticalAlignment="Center" ToolTip="수신·복호 결과와 복원 RAW를 저장할 상위 폴더입니다."/><Grid Grid.Row="3" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ResultRoot}" IsReadOnly="True" ToolTip="수신·복호 결과와 복원 RAW를 저장할 상위 폴더입니다."/><Button Grid.Column="1" Content="찾기" Command="{Binding BrowseResultRootCommand}"/></Grid></Grid></GroupBox>
      <GroupBox Grid.Column="1" Header="송신부 시험 자동 인식"><StackPanel><TextBlock Text="{Binding CurrentTest}" FontWeight="Bold" FontSize="16"/><TextBlock Margin="0,6,0,0" Text="{Binding TestConditions}" Foreground="#175CD3" TextWrapping="Wrap"/><TextBlock Margin="0,8,0,0" Text="중복 제거 → SP 검색(Test D) → 디인터리빙 → LDPC 복호 → CRC-24Q → SB3/SB4 RAW 재조립" TextWrapping="Wrap"/><TextBlock Margin="0,8,0,0" Text="시험 종류와 오류·드롭 조건은 송신부의 SessionStart에서 자동으로 전달됩니다." Foreground="#475467" TextWrapping="Wrap"/></StackPanel></GroupBox>
    </Grid>
    <GroupBox Grid.Row="1" Header="선택 판정 기준"><UniformGrid Columns="2"><StackPanel><CheckBox Content="최소 Packet Delivery Rate (%)" IsChecked="{Binding ApplyDelivery}"/><TextBox Text="{Binding MinimumDelivery}"/></StackPanel><StackPanel><CheckBox Content="최대 Packet Loss Rate (%)" IsChecked="{Binding ApplyLoss}"/><TextBox Text="{Binding MaximumLoss}"/></StackPanel></UniformGrid></GroupBox>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><GroupBox Header="복원·성능 결과"><DataGrid ItemsSource="{Binding Metrics}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="지표" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="값" Binding="{Binding Value}" Width="100"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="70"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></GroupBox><GroupBox Grid.Column="1" Header="수신 로그"><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></GroupBox></Grid>
    <Grid Grid.Row="3" Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="상태: " FontWeight="Bold"/><TextBlock Text="{Binding State}"/><TextBlock Text="   판정: " FontWeight="Bold"/><TextBlock Text="{Binding Verdict}" FontSize="17" FontWeight="Bold"/><TextBlock Text="   "/><TextBlock Text="{Binding Error}" Foreground="#B42318"/></StackPanel><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="16" Margin="0,5,10,0"/><TextBlock Text="{Binding ResultDirectory}" Foreground="#667085"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="수신 대기" Command="{Binding StartCommand}"/><Button Content="취소" Command="{Binding CancelCommand}"/><Button Content="결과 폴더" Command="{Binding OpenResultsCommand}"/></StackPanel></Grid>
  </Grid>
</Window>
