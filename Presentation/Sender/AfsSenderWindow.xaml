<Window x:Class="LnisAfsValidator.App.AfsSenderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LnisAfsValidator.App" Title="LNIS AFS 송신부" Width="1420" Height="940" MinWidth="1120" MinHeight="760" Background="#F3F5F8">
  <Window.Resources><Style TargetType="GroupBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="White"/></Style><Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style><Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="14,7"/></Style></Window.Resources>
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- 송신 입력은 기존 파일 선택과 COM 수집을 한 송신부 화면에서 준비한다. -->
    <TabControl Margin="6">
      <TabItem Header="기존 capture.graw 파일">
        <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="송신 RAW 파일" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding CapturePath}"/><Button Grid.Column="2" Content="찾아보기" Command="{Binding BrowseCaptureCommand}"/></Grid>
      </TabItem>
      <TabItem Header="GNSS COM에서 수집">
        <local:GnssCapturePanel DataContext="{Binding GnssCapture}"/>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <GroupBox Header="UDP Broadcast · 한 AFS 프레임/한 데이터그램"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Broadcast 주소" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding BroadcastAddress}"/><TextBlock Grid.Row="1" Text="데이터 포트" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DataPort}"/><TextBlock Grid.Row="2" Text="결과 포트" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ResultPort}"/><TextBlock Grid.Row="3" Text="중복 송신 횟수" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RepeatCount}"/><TextBlock Grid.Row="4" Text="결과 대기(초)" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ResultTimeoutSeconds}"/>
      </Grid></GroupBox>
      <GroupBox Grid.Column="1" Header="Test A~E 종단 간 시험" ToolTipService.ShowDuration="30000"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <!-- 시험 설정은 라벨과 입력칸 어느 쪽에 마우스를 올려도 적용 시험과 값의 의미를 확인할 수 있다. -->
        <TextBlock Text="시험 선택" VerticalAlignment="Center" ToolTip="Test A: 오류 없는 정상 송수신&#10;Test B: 프레임의 임의 위치에 Random 심볼 오류 주입&#10;Test C: 연속된 위치에 Burst 심볼 오류 주입&#10;Test D: SP를 손상시켜 다음 정상 프레임 재동기 확인&#10;Test E: UDP Frame 데이터그램 일부를 의도적으로 제거"/>
        <ComboBox Grid.Column="1" Margin="4" Padding="5" ItemsSource="{Binding TestTypes}" SelectedItem="{Binding SelectedTest}" ToolTip="Test A: 오류 없는 정상 송수신&#10;Test B: 프레임의 임의 위치에 Random 심볼 오류 주입&#10;Test C: 연속된 위치에 Burst 심볼 오류 주입&#10;Test D: SP를 손상시켜 다음 정상 프레임 재동기 확인&#10;Test E: UDP Frame 데이터그램 일부를 의도적으로 제거"/>
        <TextBlock Grid.Row="1" Text="오류 심볼 수" VerticalAlignment="Center" ToolTip="Test B/C에서는 각 AFS 프레임에 주입할 오류 심볼 수입니다(1~5880).&#10;Test D에서는 SP 68심볼 중 손상할 심볼 수입니다(1~68).&#10;Test A/E에서는 사용하지 않습니다."/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ErrorCount}" ToolTip="Test B/C에서는 각 AFS 프레임에 주입할 오류 심볼 수입니다(1~5880).&#10;Test D에서는 SP 68심볼 중 손상할 심볼 수입니다(1~68).&#10;Test A/E에서는 사용하지 않습니다."/>
        <TextBlock Grid.Row="2" Text="오류 Seed" VerticalAlignment="Center" ToolTip="Test B/C/D 오류 위치를 반복 가능하게 결정하는 정수입니다.&#10;같은 입력·오류 수·Seed를 사용하면 같은 위치에 오류가 주입됩니다.&#10;Test A/E에서는 사용하지 않습니다."/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ErrorSeed}" ToolTip="Test B/C/D 오류 위치를 반복 가능하게 결정하는 정수입니다.&#10;같은 입력·오류 수·Seed를 사용하면 같은 위치에 오류가 주입됩니다.&#10;Test A/E에서는 사용하지 않습니다."/>
        <TextBlock Grid.Row="3" Text="SP 손상 간격" VerticalAlignment="Center" ToolTip="Test D에서 몇 프레임마다 SP를 손상할지 지정합니다.&#10;예: 10이면 0, 10, 20번째 프레임의 SP를 손상합니다. 마지막 프레임은 다음 SP가 없으므로 손상하지 않습니다.&#10;Test A/B/C/E에서는 사용하지 않습니다."/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SyncDamageInterval}" ToolTip="Test D에서 몇 프레임마다 SP를 손상할지 지정합니다.&#10;예: 10이면 0, 10, 20번째 프레임의 SP를 손상합니다. 마지막 프레임은 다음 SP가 없으므로 손상하지 않습니다.&#10;Test A/B/C/E에서는 사용하지 않습니다."/>
        <TextBlock Grid.Row="4" Text="UDP Drop Rate (%)" VerticalAlignment="Center" ToolTip="Test E에서 AFS Frame 데이터그램 전송을 생략할 목표 비율입니다(0~100%).&#10;SessionStart/End와 Result 같은 제어 패킷은 제거하지 않습니다.&#10;중복 송신 횟수가 크면 같은 논리 프레임의 다른 복제본이 도착할 수 있습니다."/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DropRatePercent}" ToolTip="Test E에서 AFS Frame 데이터그램 전송을 생략할 목표 비율입니다(0~100%).&#10;SessionStart/End와 Result 같은 제어 패킷은 제거하지 않습니다.&#10;중복 송신 횟수가 크면 같은 논리 프레임의 다른 복제본이 도착할 수 있습니다."/>
        <TextBlock Grid.Row="5" Text="UDP Drop Seed" VerticalAlignment="Center" ToolTip="Test E에서 어떤 Frame Sequence·복제본을 제거할지 반복 가능하게 결정하는 정수입니다.&#10;같은 조건과 Seed를 사용하면 같은 데이터그램이 제거됩니다.&#10;Test A/B/C/D에서는 사용하지 않습니다."/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DropSeed}" ToolTip="Test E에서 어떤 Frame Sequence·복제본을 제거할지 반복 가능하게 결정하는 정수입니다.&#10;같은 조건과 Seed를 사용하면 같은 데이터그램이 제거됩니다.&#10;Test A/B/C/D에서는 사용하지 않습니다."/>
        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="4,10" TextWrapping="Wrap" Foreground="#475467" Text="A는 정상 전송, B/C는 실제 프레임의 Random/Burst 오류, D는 지정 간격 프레임의 SP 훼손, E는 Frame 데이터그램 Drop입니다. 선택한 시험에 해당하는 값만 적용됩니다."/>
      </Grid></GroupBox>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><GroupBox Header="수신부 반환 성능지표"><DataGrid ItemsSource="{Binding Metrics}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="지표" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="값" Binding="{Binding Value}" Width="100"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="70"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></GroupBox><GroupBox Grid.Column="1" Header="송신 로그"><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></GroupBox></Grid>
    <Grid Grid.Row="3" Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="상태: " FontWeight="Bold"/><TextBlock Text="{Binding State}"/><TextBlock Text="   판정: " FontWeight="Bold"/><TextBlock Text="{Binding Verdict}" FontSize="17" FontWeight="Bold"/><TextBlock Text="   "/><TextBlock Text="{Binding Error}" Foreground="#B42318"/></StackPanel><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="16" Margin="0,5,10,0"/><TextBlock Text="{Binding ResultDirectory}" Foreground="#667085"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="시험 시작" Command="{Binding StartCommand}"/><Button Content="취소" Command="{Binding CancelCommand}"/><Button Content="결과 폴더" Command="{Binding OpenResultsCommand}"/></StackPanel></Grid>
  </Grid>
</Window>
